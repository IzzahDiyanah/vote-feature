# copy to .env and change the values, do not commit .env
# used by docker compose

# local postgres password (dev only)
POSTGRES_PASSWORD=postgres

# signs the login tokens, use a long random string (16+ chars)
# openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string

# web app address, the API only allows requests from here
WEB_ORIGIN=http://localhost:3000
