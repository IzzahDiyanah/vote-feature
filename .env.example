# Copy this file to ".env" and change the values. Never commit ".env".
# Used by docker compose.

# Password for the local Postgres container (local development only)
POSTGRES_PASSWORD=postgres

# Secret used to sign login tokens. Use a long random string, at least 16 characters.
# Generate one with:  openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string

# The address of the web app. The API only accepts browser requests from here.
WEB_ORIGIN=http://localhost:3000
