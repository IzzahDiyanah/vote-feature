# for running the API outside docker (npm run start:dev), copy to .env
# with docker compose use the .env in the repo root instead
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/featurevote
JWT_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
PORT=3001

# used by npm test (separate db so dev data is untouched)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/featurevote_test
