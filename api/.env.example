# For running the API outside Docker (npm run start:dev). Copy to ".env".
# With docker compose you do not need this file; use the .env in the repo root instead.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/featurevote
JWT_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
PORT=3001

# Used by `npm test` (a separate database, so tests never touch your dev data)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/featurevote_test
